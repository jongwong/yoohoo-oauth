    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "jotai": "^2.10.1",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^5.3.4",
    "uuid": "^3.3.3"
  },
