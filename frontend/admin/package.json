{
  "name": "live-editor-ui",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "monaco-treemending": "./bin/monaco-treemending.js"
  },
  "scripts": {
    "build": "webpack --env NODE_ENV=production   ",
    "dev": "webpack serve --env  NODE_ENV=development APP_ENV=test",
    "start": "npm run dev:rs",
    "prepare": "husky install",
    "lint": "npx lint-staged",
    "start:vite": "vite",
    "dev:rs": "cross-env NODE_ENV=development rspack serve",
    "server": "cross-env NODE_ENV=development rspack serve --config=rspack-server.config.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{css,less}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "ahooks": "^3.7.7",
    "ali-oss": "^6.22.0",
